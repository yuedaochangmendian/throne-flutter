<?xml version="1.0" encoding="utf-8"?>
<io.nekohasekai.sagernet.glass.GlassAppBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appbar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    app:elevation="0dp"
    app:liftOnScroll="false">

    <!-- No colorPrimary fill any more: the glass is the AppBarLayout's background, the toolbar is
         the content floating on it. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:theme="?actionBarTheme"
        android:touchscreenBlocksFocus="false"
        app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
        app:title="@string/app_name" />
</io.nekohasekai.sagernet.glass.GlassAppBarLayout>
